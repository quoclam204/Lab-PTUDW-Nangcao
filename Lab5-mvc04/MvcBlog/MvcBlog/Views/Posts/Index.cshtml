@model IEnumerable<MvcBlog.Post>

@{
    ViewBag.Title = "Posts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3">Posts</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
</div>

@* Form tìm kiếm: GET để có thể share link *@
@using (Html.BeginForm("Index", "Posts", FormMethod.Get, new { @class = "card card-body mb-3" }))
{
    <div class="row g-2">
        <div class="col-md-3">
            @Html.Label("Loại Blog")
            @Html.DropDownList(
                "blogId",
                (SelectList)ViewBag.Blogs ?? new SelectList(Enumerable.Empty<string>()),
                "— Tất cả —",
                new { @class = "form-select", @value = ViewBag.SelBlogId }
            )
        </div>

        <div class="col-md-3">
            @Html.Label("Tiêu đề")
            <input name="title" value="@ViewBag.TitleKey" class="form-control" />
        </div>

        <div class="col-md-2">
            @Html.Label("Từ ngày")
            <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
        </div>

        <div class="col-md-2">
            @Html.Label("Đến ngày")
            <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-outline-primary w-100" type="submit">Tìm</button>
        </div>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">@Html.ValidationSummary()</div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Blog</th>
            <th>Title</th>
            <th>Content</th>
            <th>CreatedDate</th>
            <th style="width:160px">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Blog != null ? item.Blog.Name : item.BlogId.ToString())</td>
                    <td>@item.Title</td>
                    <td>@item.Content</td>
                    <td>@string.Format("{0:yyyy-MM-dd HH:mm}", item.CreatedDate)</td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Edit", "Edit", new { id = item.PostId }) |
                        @Html.ActionLink("Details", "Details", new { id = item.PostId }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.PostId })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5"><em>Không có dữ liệu.</em></td></tr>
        }
    </tbody>
</table>
