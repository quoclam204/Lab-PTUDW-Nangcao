@model IEnumerable<MvcBlog.Blog>

@{
    ViewBag.Title = "Blogs";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Màu nền theo Rank
    Func<int?, string> bgByRank = r =>
    {
        if (!r.HasValue) return "white";
        if (r >= 85) return "red";          // 85–100
        if (r >= 70) return "yellow";       // 70–84
        if (r >= 55) return "blue";         // 55–69
        if (r >= 40) return "lightblue";    // 40–54
        return "black";                     // < 40
    };
    Func<string, string> fgByBg = bg =>
        (bg == "red" || bg == "blue" || bg == "black") ? "white" : "black";
}

<h2 class="mb-3">Blogs</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge" style="background:red;color:white">≥85</span>
        <span class="badge" style="background:yellow;color:black">70–84</span>
        <span class="badge" style="background:blue;color:white">55–69</span>
        <span class="badge" style="background:lightblue;color:black">40–54</span>
        <span class="badge" style="background:black;color:white">&lt;40</span>
    </div>
    @Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })
</div>

@using (Html.BeginForm("Index", "Blog", FormMethod.Get, new { @class = "card card-body mb-3" }))
{
    <div class="row g-2">
        <div class="col-md-3">
            @Html.Label("Tên Blog")
            <input name="name" value="@ViewBag.Name" class="form-control" />
        </div>
        <div class="col-md-5">
            @Html.Label("Mô tả")
            <input name="des" value="@ViewBag.Des" class="form-control" />
        </div>
        <div class="col-md-3">
            @Html.Label("Chủ sở hữu")
            @Html.DropDownList(
                "own",
                (SelectList)ViewBag.Owners ?? new SelectList(Enumerable.Empty<string>()),
                "— Tất cả —",
                new { @class = "form-select", @value = ViewBag.Own }
            )
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Tìm</button>
        </div>
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor((MvcBlog.Blog b) => b.Name)</th>
            <th>@Html.DisplayNameFor((MvcBlog.Blog b) => b.Description)</th>
            <th>@Html.DisplayNameFor((MvcBlog.Blog b) => b.Owner)</th>
            <th>@Html.DisplayNameFor((MvcBlog.Blog b) => b.Rank)</th>
            <th style="width:160px">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                var bg = bgByRank(item.Rank);
                var fg = fgByBg(bg);
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Owner</td>
                    <td class="text-center fw-bold" style="background-color:@bg;color:@fg">
                        @(item.Rank.HasValue ? item.Rank.Value.ToString() : "-")
                    </td>
                    <td class="text-nowrap">
                        @Html.ActionLink("Edit", "Edit", new { id = item.BlogId }) |
                        @Html.ActionLink("Details", "Details", new { id = item.BlogId }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.BlogId })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5"><em>Không có dữ liệu.</em></td></tr>
        }
    </tbody>
</table>
