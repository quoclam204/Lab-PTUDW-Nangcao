@model IEnumerable<MvcBlog.Blog>

@{
    ViewBag.Title = "Blogs";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Chọn màu nền theo Rank
    Func<int?, string> bgByRank = r =>
    {
        if (!r.HasValue) return "white";   // không có Rank -> để nền trắng
        if (r >= 85) return "red";         // 85–100
        if (r >= 70) return "yellow";      // 70–84
        if (r >= 55) return "blue";        // 55–69 (xanh đậm)
        if (r >= 40) return "lightblue";   // 40–54 (xanh nhạt)
        return "black";                    // < 40
    };
    // Chọn màu chữ phù hợp để dễ đọc
    Func<string, string> fgByBg = bg =>
    {
        return (bg == "red" || bg == "blue" || bg == "black") ? "white" : "black";
    };
}

<h2>Blogs</h2>

<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.Description)</th>
            <th>@Html.DisplayNameFor(m => m.Owner)</th>
            <th>@Html.DisplayNameFor(m => m.Rank)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                // Tính màu cho riêng ô Rank
                var bg = !item.Rank.HasValue ? "white"
                         : item.Rank >= 85 ? "red"
                         : item.Rank >= 70 ? "yellow"
                         : item.Rank >= 55 ? "blue"
                         : item.Rank >= 40 ? "lightblue"
                         : "black";
                var fg = (bg == "red" || bg == "blue" || bg == "black") ? "white" : "black";

                <tr>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@item.Owner</td>

                    <!-- Chỉ ô Rank được tô màu -->
                    <td style="background-color:@bg; color:@fg; text-align:center; font-weight:bold;">
                        @(item.Rank.HasValue ? item.Rank.Value.ToString() : "-")
                    </td>

                    <td>
                        @Html.ActionLink("Edit", "Edit", new { id = item.BlogId }) |
                        @Html.ActionLink("Details", "Details", new { id = item.BlogId }) |
                        @Html.ActionLink("Delete", "Delete", new { id = item.BlogId })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5"><em>Không có dữ liệu.</em></td></tr>
        }
    </tbody>




</table>
