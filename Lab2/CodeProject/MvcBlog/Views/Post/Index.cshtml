@model IEnumerable<EntityModel.Post>
@{
    ViewBag.Title = "All Posts";
}
<h2>All Posts</h2>
<table class="table">
    <thead><tr><th>ID</th><th>Title</th><th>BlogId</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PostId</td>
                <td>@p.Title</td>
                <td>@p.BlogId</td>
                <td>@Html.ActionLink("Xem", "Get", new { id = p.PostId })</td>
            </tr>
        }
    </tbody>
</table>
